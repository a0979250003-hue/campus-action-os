# 仅服务端使用。不要把真实密钥提交到仓库，也不要下发到小程序端。
# 用法：复制本文件为 .env.local（已被 .gitignore 忽略），再填入真实值。

# 必填。未配置时 /upload 仍会完成文件解析，但 analysis 会返回明确错误，不会伪造分析结果。
OPENROUTER_API_KEY=

# 选填。OpenRouter 兼容网关地址，默认 https://openrouter.ai/api/v1。
OPENROUTER_BASE_URL=

# 选填。主模型，默认 openrouter/free。
OPENROUTER_MODEL=

# 选填。备用模型列表，英文逗号分隔。
OPENROUTER_FALLBACK_MODELS=
